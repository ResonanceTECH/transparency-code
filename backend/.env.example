# Скопируйте в .env и заполните реальными значениями. .env не коммитится (см. .gitignore).
# В репозитории секретов нет — здесь только структура переменных.

# PostgreSQL. Логин и пароль подставляются только в .env, в репозитории их нет.
DATABASE_URL=postgresql+asyncpg://resonance@localhost:5432/resonance

# Ключ для подписанных токенов. Сгенерировать: openssl rand -hex 32
SECRET_KEY=

DEMO_USERNAME=demo
# DEMO_PASSWORD не задаётся — используется демо-значение по умолчанию
# (учебный контур, только синтетические данные; в проде ALLOW_DEMO_LOGIN=false).
ALLOW_DEMO_LOGIN=true

UPLOAD_DIR=./uploads
SESSION_TTL_HOURS=12
MAX_UPLOAD_MB=5
RULE_VERSION=0.1.0
LOG_LEVEL=INFO
