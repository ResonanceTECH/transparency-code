# Скопируйте в .env и заполните. .env не коммитится (см. .gitignore).

# Пароль PostgreSQL. Только латиница и цифры — подставляется в DATABASE_URL.
# Сгенерировать: openssl rand -hex 16
POSTGRES_PASSWORD=

# Ключ для подписанных токенов сессий. Сгенерировать: openssl rand -hex 32
SECRET_KEY=

# Флаг Secure на сессионной cookie. Стек отдается по http без TLS,
# поэтому по умолчанию false, иначе браузер не отправит cookie и вход не сработает.
# При запуске через docker-compose.tls.yml сам становится true.
COOKIE_SECURE=false

# Домен для Caddy в docker-compose.tls.yml. По умолчанию nip.io поддомен сервера,
# при появлении своего домена указать его здесь и направить DNS на сервер.
# TLS_DOMAIN=135.106.155.218.nip.io

# Порт, на котором frontend (nginx) принимает HTTP. По умолчанию 80.
# Для запуска интеграционных тестов frontend/tests/flow.spec.ts нужен 8080:
#   HTTP_PORT=8080 docker compose up -d --build
HTTP_PORT=80

# Только для docker-compose.prod.yml и только если пакеты GHCR приватные:
# GitHub-логин и PAT со scope read:packages. Для публичных пакетов оставить пустыми.
GHCR_USER=
GHCR_TOKEN=
