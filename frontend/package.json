{
  "name": "resonance-ui",
  "description": "Резонанс — клиент и API финансового профиля резервиста",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scarfSettings": {
    "enabled": false
  },
  "scripts": {
    "predev": "node tools/copy-docs.mjs",
    "dev": "vite --host 127.0.0.1",
    "predev:prototype": "node tools/copy-docs.mjs",
    "dev:prototype": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "prebuild": "node tools/copy-docs.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:prototype": "playwright test --config playwright.prototype.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "screenshots:prototype": "node tools/capture-financial-profile.mjs"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.4.1",
    "prettier": "3.6.2",
    "swagger-ui-dist": "5.34.1",
    "typescript": "5.8.3",
    "vite": "6.4.5"
  }
}
